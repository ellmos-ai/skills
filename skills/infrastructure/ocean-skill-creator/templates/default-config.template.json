{
  "_hinweis": "Standard-Fallback-Konfiguration (default-config.json) fuer jeden mit ocean-skill-creator erzeugten Skill. Bleibt 100 % nutzerneutral im Repo; lokale Overrides liegen in config.json sowie optional in profiles/<kanal>.json und profiles/<kanal>.<chat>.json.",
  "schema": "ocean.skill-config.v2",
  "legacy_schema_compat": "ellmos.skill-config.v1",
  "skill": "{{skill-name}}",
  "version": "0.1.0",
  "settings": {
    "language": "de",
    "max_items": 50
  },
  "output": {
    "default_format": "md",
    "supported_formats": ["html", "pdf", "md", "txt", "json"],
    "pdf_stdlib_fallback": true,
    "output_dir": "./output"
  },
  "templates": {
    "dir": "./templates",
    "custom_dir": null,
    "html": "report.template.html",
    "md": "report.template.md",
    "txt": "report.template.txt"
  },
  "delivery": {
    "enabled": false,
    "dry_run": true,
    "mode": "draft",
    "channel": null,
    "target": null
  },
  "self_healing": {
    "enabled": true,
    "backup_corrupt": true,
    "backup_suffix_format": ".corrupt.{timestamp}.bak",
    "additive_migration": true,
    "atomic_write": true
  },
  "profiles": {
    "dir": "./profiles",
    "active_channel": null,
    "active_chat": null
  },
  "lernvertrag": {
    "user_ist_koenig": true,
    "waehle_beste_option": true,
    "installiert_nie_selbststaendig": true,
    "letzter_update_check": null,
    "update_intervall_tage": 60
  },
  "letzter_check": null
}
