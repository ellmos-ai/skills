{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision form data v1",
  "description": "Input of build_form.py. Length limits are errors in the generator, never silently truncated; keep this file in step with LIMITS in build_form.py (the self-test checks it).",
  "type": "object",
  "required": ["schema", "dokument_id", "titel", "kontext_kurz", "buendel"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "ellmos.decision-form.v1"},
    "dokument_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,59}$", "description": "Used in the file names of the answer."},
    "titel": {"type": "string", "minLength": 1, "maxLength": 80},
    "kontext_kurz": {"type": "string", "minLength": 1, "maxLength": 400, "description": "At most three sentences: what this is about, enough to remind the reader of the project."},
    "zielordner": {"type": "string", "maxLength": 120, "description": "Optional wished folder for the answer, named in the document. The browser may refuse it."},
    "buendel": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "titel", "posten"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,39}$"},
          "titel": {"type": "string", "minLength": 1, "maxLength": 80},
          "posten": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/posten"}}
        }
      }
    }
  },
  "$defs": {
    "posten": {
      "type": "object",
      "required": ["kuerzel", "titel", "kontext", "frage", "optionen", "kosten_aufwand", "risiko_rueckgaengig", "folge_bei_nein"],
      "additionalProperties": false,
      "properties": {
        "kuerzel": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,39}$"},
        "titel": {"type": "string", "minLength": 1, "maxLength": 80},
        "kontext": {"type": "string", "minLength": 1, "maxLength": 250, "description": "At most two sentences: what is it about, what does it remind of."},
        "frage": {"type": "string", "minLength": 1, "maxLength": 200},
        "optionen": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["id", "label", "wirkung"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9]{1,3}$", "not": {"const": "rueckfrage"}},
              "label": {"type": "string", "minLength": 1, "maxLength": 100},
              "wirkung": {"type": "string", "minLength": 1, "maxLength": 160, "description": "One sentence: what happens if this is chosen."}
            }
          }
        },
        "empfehlung": {
          "type": "object",
          "required": ["option", "grund"],
          "additionalProperties": false,
          "properties": {
            "option": {"type": "string"},
            "grund": {"type": "string", "minLength": 1, "maxLength": 160, "description": "One sentence."}
          }
        },
        "kosten_aufwand": {"type": "string", "minLength": 1, "maxLength": 160, "description": "May say 'keine', must not be missing."},
        "risiko_rueckgaengig": {"type": "string", "minLength": 1, "maxLength": 160, "description": "Risk and whether it can be undone. May say 'keine', must not be missing."},
        "frist": {"type": "string", "minLength": 1, "maxLength": 160},
        "folge_bei_nein": {"type": "string", "minLength": 1, "maxLength": 160, "description": "What happens if nothing or 'no' is chosen. May say 'keine', must not be missing."},
        "avatar": {
          "type": "object",
          "required": ["konfidenz"],
          "additionalProperties": false,
          "properties": {
            "wahl": {"type": ["string", "null"]},
            "konfidenz": {"enum": ["grün", "gruen", "gelb", "rot"]}
          }
        },
        "sensitiv": {"type": "boolean", "description": "Red, money, deletion, external effect, licence or rights of third parties: listed again before saving."},
        "sensitiv_grund": {"type": "string", "maxLength": 100},
        "details_markdown": {"type": "string", "maxLength": 4000, "description": "Only collapsible. Escaped before conversion; links with javascript:, data: or vbscript: are refused."},
        "bilder": {
          "type": "array",
          "maxItems": 12,
          "description": "Optional series of images above the decision fields. One decision belongs to the whole series. Each image is embedded as a data: URI (at most 400 KB per image, 8 MB per form).",
          "items": {
            "type": "object",
            "required": ["beschriftung"],
            "additionalProperties": false,
            "oneOf": [{"required": ["pfad"]}, {"required": ["data_uri"]}],
            "properties": {
              "pfad": {"type": "string", "description": "Source file at build time, relative to the data file."},
              "data_uri": {"type": "string", "pattern": "^data:image/(png|jpeg|webp|gif);base64,"},
              "beschriftung": {"type": "string", "minLength": 1, "maxLength": 120},
              "alt": {"type": "string", "maxLength": 200},
              "seite": {"type": "string", "maxLength": 60},
              "variante": {"type": "string", "maxLength": 60}
            }
          }
        }
      }
    }
  }
}
