{
  "schema": "ocean.skill-config.v2",
  "skill": "decision-shot",
  "version": "1.3.0",
  "budgets": {
    "context_min_lines": 2,
    "context_max_lines": 3,
    "option_bullets_min": 2,
    "option_bullets_max": 4,
    "talking_points_min": 2,
    "talking_points_max": 3,
    "recommendation_sentences": 1
  },
  "style": {
    "first_person_context": true,
    "hide_technical_ids_in_body": true,
    "require_full_analysis_link": true,
    "preserve_negations": true,
    "group_separator": "---"
  },
  "output": {
    "default_format": "md",
    "supported_formats": [
      "md",
      "txt"
    ]
  },
  "templates": {
    "dir": "./templates",
    "md": "decision-shot.template.md",
    "custom_dir": null
  }
}
