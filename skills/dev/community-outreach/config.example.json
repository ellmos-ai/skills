{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "instance_name": "Universal Community Outreach",
  "workspace_path": "./community_outreach_data",
  "schedule": {
    "frequency": "daily",
    "cron": "0 10 * * *",
    "backend": "antigravity"
  },
  "platforms": {
    "rotation": [
      "Reddit",
      "YouTube",
      "GitHub Discussions",
      "Foren"
    ],
    "reddit": {
      "enabled": true,
      "subreddits": ["programming", "opensource", "webdev", "python"]
    },
    "youtube": {
      "enabled": true,
      "query_topics": ["open source tutorial", "developer tools"]
    },
    "forums": {
      "enabled": true,
      "domains": ["news.ycombinator.com"]
    }
  },
  "compliance": {
    "human_in_the_loop": true,
    "require_approval_checkbox": true,
    "require_code_evidence": true,
    "require_claim_contract": true,
    "require_natural_style": true,
    "max_posts_per_cycle": 1,
    "excluded_orgs": ["biotec-line"]
  },
  "verification": {
    "local_repos_root": "./repos",
    "forbid_memory_or_summary_only_drafts": true,
    "forbid_ai_essay_formatting": true
  }
}
